
#include <stdio.h>
#include <stdlib.h>

int my_atoi(const char *);

int main()
{
    int n;
    char s[50];

    printf("enter the string\n");
    scanf("%49[^\n]", s);

    n = my_atoi(s);

    printf("%d\n", n);

    return 0;
}

int my_atoi(const char *p)
{
    int num = 0;
    int j = 1;

    while (*p == ' ' || *p == '\t' || *p == '\r' || *p == '\n')
        p++;

    if (*p == '-')
    {
        j = -1;
        p++;
    }
    else if (*p == '+')
    {
        p++;
    }

    while (*p >= '0' && *p <= '9')
    {
        num = num * 10 + (*p - '0');
        p++;
    }

    return num * j;
}
